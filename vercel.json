{
  "rewrites": [
    { "source": "/digest", "destination": "/api/index" },
    { "source": "/api/tickers/search", "destination": "/api/index" },
    { "source": "/api/tickers/validate", "destination": "/api/index" },
    { "source": "/api/subscribe", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/digest",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
