{
  "rewrites": [
    { "source": "/digest", "destination": "/api/digest" },
    { "source": "/api/tickers/search", "destination": "/api/tickers_search" },
    { "source": "/api/tickers/validate", "destination": "/api/tickers_validate" }
  ],
  "headers": [
    {
      "source": "/api/digest",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
