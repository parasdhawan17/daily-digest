# Copy to .env.local for vercel dev (never commit secrets)

FINNHUB_API_KEY=your-finnhub-key
DIGEST_SIGNING_SECRET=generate-with-openssl-rand-hex-32
SITE_URL=http://localhost:3000
# Production: https://www.mydailydigest.online

# Subscribe form (copy from stock-news-bot/.env)
BREVO_API_KEY=your-brevo-api-key
BREVO_LIST_ID=your-list-id
BREVO_DOI_TEMPLATE_ID=your-doi-template-id

# Optional AI briefing (leave the key blank to disable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Tickr Digest
AI_SUMMARY_TIMEOUT_SECONDS=15
AI_SUMMARY_MAX_STORIES=30
AI_SUMMARY_MAX_OUTPUT_TOKENS=700
